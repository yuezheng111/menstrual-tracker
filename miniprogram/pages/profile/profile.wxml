<view class="page-profile">
  <!-- Profile Header -->
  <glass-card customClass="profile-header">
    <view class="profile-avatar">🌸</view>
    <view class="profile-name-row" bindtap="editNickname">
      <text class="profile-name">{{userInfo.nickname || userInfo.username || "用户"}}</text>
      <text class="profile-name-edit">✏️</text>
    </view>
  </glass-card>

  <!-- Admin Entry (仅管理员可见) -->
  <view wx:if="{{userInfo.role === 'ADMIN'}}" class="admin-entry glass" bindtap="goToAdmin">
    <text class="admin-entry-emoji">🔐</text>
    <view class="admin-entry-text">
      <view class="admin-entry-title">管理后台</view>
      <view class="admin-entry-desc">用户管理 · 数据看板 · 标签 · 导出</view>
    </view>
    <text class="admin-entry-arrow">›</text>
  </view>

  <!-- Logout -->
  <view class="logout-section" bindtap="logout">
    <text>退出登录</text>
  </view>

  <view class="version">暖暖经期记录 v1.0.0</view>
</view>
