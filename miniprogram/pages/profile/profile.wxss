.page-profile {
  padding: 0 16px;
}

.profile-header {
  text-align: center;
  padding: 32px 20px !important;
  margin-bottom: 12px;
}
.profile-avatar {
  font-size: 56px;
  margin-bottom: 8px;
  animation: heartBeat 2s ease-in-out infinite;
}
.profile-name {
  display: block;
  font-size: 20px;
  font-weight: 700;
  color: #4a154b;
}
.profile-email {
  display: block;
  font-size: 13px;
  color: #8e5580;
  margin-top: 4px;
}

.settings-card {
  padding: 20px !important;
  margin-bottom: 12px;
}
.section-title {
  font-size: 15px;
  font-weight: 600;
  color: #4a154b;
  margin-bottom: 16px;
}

.form-group {
  margin-bottom: 12px;
}
.form-label {
  display: block;
  font-size: 13px;
  font-weight: 500;
  color: #8e5580;
  margin-bottom: 6px;
}
.form-row {
  display: flex;
  gap: 10px;
}

.input-glass {
  background: rgba(255,255,255,0.20);
  backdrop-filter: blur(8px);
  border: 1.5px solid rgba(255,255,255,0.30);
  border-radius: 14px;
  padding: 12px 14px;
  font-size: 15px;
  color: #4a154b;
  width: 100%;
}
.picker-trigger {
  color: #4a154b;
  line-height: 1.4;
}

.logout-section {
  text-align: center;
  padding: 20px;
  font-size: 15px;
  color: #c89bb8;
}
.logout-section:active {
  opacity: 0.6;
}

.version {
  text-align: center;
  font-size: 12px;
  color: #c89bb8;
  padding-bottom: 40px;
}
