.page-profile {
  padding: 0 16px;
}

.profile-header {
  text-align: center;
  padding: 32px 20px !important;
  margin-bottom: 12px;
}
.profile-avatar {
  font-size: 56px;
  margin-bottom: 8px;
  animation: heartBeat 2s ease-in-out infinite;
}
.profile-name {
  display: block;
  font-size: 20px;
  font-weight: 700;
  color: #4a154b;
}
.profile-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 8px;
}
.profile-name-edit {
  font-size: 14px;
  color: #ec407a;
}

.logout-section {
  text-align: center;
  padding: 20px;
  font-size: 15px;
  color: #c89bb8;
}
.logout-section:active {
  opacity: 0.6;
}

.version {
  text-align: center;
  font-size: 12px;
  color: #c89bb8;
  padding-bottom: 40px;
}
.icp-footer {
  text-align: center;
  font-size: 12px;
  color: #b48aa8;
  padding-bottom: 24px;
}

.admin-entry {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.admin-entry-emoji { font-size: 44rpx; }
.admin-entry-text { flex: 1; }
.admin-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.admin-entry-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}
.admin-entry-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
}
