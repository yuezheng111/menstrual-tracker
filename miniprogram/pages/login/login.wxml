<view class="page-wxlogin">
  <view class="wxlogin-content">
    <view class="logo-section animate-fade-up">
      <view class="logo-emoji">🌸</view>
      <text class="app-name">暖暖月经记录</text>
      <text class="app-desc">温柔记录 · 智能预测</text>
    </view>

    <view class="wxlogin-card glass animate-fade-up">
      <button class="wxlogin-btn" bindtap="handleWxLogin" loading="{{loading}}">
        <text>{{loading ? "登录中..." : "微信一键登录"}}</text>
      </button>
      <view class="agreement">
        <text>登录即表示同意</text>
        <text class="link">用户协议</text>
        <text>和</text>
        <text class="link">隐私政策</text>
      </view>
    </view>
  </view>
</view>
