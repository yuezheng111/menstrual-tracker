.page-wxlogin {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 24px;
}

.wxlogin-content {
  width: 100%;
  max-width: 340px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Logo */
.logo-section {
  text-align: center;
  margin-bottom: 40px;
}
.logo-emoji {
  font-size: 64px;
  margin-bottom: 12px;
  animation: heartBeat 2s ease-in-out infinite;
}
.app-name {
  display: block;
  font-size: 26px;
  font-weight: 700;
  color: #4a154b;
  letter-spacing: 2px;
}
.app-desc {
  display: block;
  font-size: 14px;
  color: #8e5580;
  margin-top: 6px;
}

/* Login card */
.wxlogin-card {
  width: 100%;
  padding: 32px 24px !important;
  text-align: center;
}

/* WeChat login button */
.wxlogin-btn {
  width: 100%;
  padding: 14px 0;
  background: #07c160;
  border: none;
  border-radius: 24px;
  color: white;
  font-size: 16px;
  font-weight: 600;
  line-height: 1;
  transition: all 0.3s;
}
.wxlogin-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

/* Agreement */
.agreement {
  margin-top: 20px;
  font-size: 12px;
  color: #8e5580;
  line-height: 1.8;
}
.agreement-check {
  display: inline-flex;
  align-items: center;
  margin-right: 4px;
}
.agreement-check checkbox {
  transform: scale(0.8);
  margin-right: 2px;
}
.link {
  color: #f06292;
  text-decoration: underline;
}
.icp-footer {
  margin-top: 24px;
  text-align: center;
  font-size: 12px;
  color: #b48aa8;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  15% { transform: scale(1.15); }
  30% { transform: scale(1); }
  45% { transform: scale(1.1); }
  60% { transform: scale(1); }
}
