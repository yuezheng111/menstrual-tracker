<view class="change-password-page">
  <view class="change-card glass">
    <view class="change-title">🔐 修改密码</view>
    <view class="change-sub">首次登录请设置新密码</view>

    <view class="form-group">
      <text class="form-label">原密码</text>
      <input class="input-glass" password value="{{oldPassword}}" data-field="oldPassword" bindinput="onInput" placeholder="请输入原密码" />
    </view>
    <view class="form-group">
      <text class="form-label">新密码</text>
      <input class="input-glass" password value="{{newPassword}}" data-field="newPassword" bindinput="onInput" placeholder="至少8位" />
    </view>
    <view class="form-group">
      <text class="form-label">确认新密码</text>
      <input class="input-glass" password value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" placeholder="再次输入新密码" />
    </view>

    <button class="change-btn" loading="{{loading}}" bindtap="handleChange">确认修改</button>
  </view>
</view>
