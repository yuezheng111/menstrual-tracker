.admin-login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.login-card {
  width: 100%;
  padding: 48rpx 40rpx;
}
.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}
.login-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin: 12rpx 0 40rpx;
}
.form-group {
  margin-bottom: 28rpx;
}
.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}
.login-card .input-glass {
  width: 72%;
  display: block;
  margin: 0 auto;
}
.login-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #f06292, #ce93d8);
  color: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.login-btn::after { border: none; }
