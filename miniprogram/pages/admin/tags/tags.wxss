.admin-page { padding: 24rpx; }
.filter-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.filter-chip {
  background: rgba(255,255,255,0.3);
  border: 1px solid var(--glass-border);
  border-radius: 32rpx;
  padding: 12rpx 36rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.chip-active {
  background: linear-gradient(135deg, #f06292, #ce93d8);
  color: #fff;
  border-color: transparent;
}
.tag-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.tag-color {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.tag-info { flex: 1; min-width: 0; }
.tag-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.tag-type {
  font-size: 20rpx;
  background: rgba(236,64,122,0.12);
  color: var(--pink-500);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.tag-meta { font-size: 24rpx; color: var(--text-secondary); margin-top: 6rpx; }
.tag-del {
  background: rgba(245,108,108,0.15);
  color: #f56c6c;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}
.empty-text {
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  padding: 60rpx 0;
}
