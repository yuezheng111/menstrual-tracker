.admin-page { padding: 24rpx; }
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.search-input { flex: 1; }
.search-btn {
  background: linear-gradient(135deg, #f06292, #ce93d8);
  color: #fff;
  border-radius: 16rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
}
.clear-btn {
  background: rgba(255,255,255,0.35);
  border-radius: 50%;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--text-secondary);
  font-size: 24rpx;
}
.user-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.user-info { flex: 1; min-width: 0; }
.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.tag-role {
  font-size: 20rpx;
  background: rgba(144,147,153,0.2);
  color: #909399;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.tag-admin {
  background: rgba(236,64,122,0.15);
  color: var(--pink-500);
}
.user-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.user-actions { display: flex; flex-direction: column; gap: 12rpx; }
.mini-btn {
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
  text-align: center;
  color: #fff;
}
.btn-warn { background: #f0a020; }
.btn-ok { background: #67c23a; }
.btn-reset { background: #409eff; }
.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 24rpx 0;
}
.pager-btn {
  background: rgba(255,255,255,0.4);
  border: 1px solid var(--glass-border);
  border-radius: 32rpx;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}
.pager-info { font-size: 26rpx; color: var(--text-secondary); }
.empty-text {
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  padding: 60rpx 0;
}
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal-card {
  width: 600rpx;
  padding: 40rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
}
.modal-sub {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  margin: 12rpx 0 24rpx;
}
.modal-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.4);
  color: var(--text-primary);
  font-size: 30rpx;
}
.modal-btn-primary {
  background: linear-gradient(135deg, #f06292, #ce93d8);
  color: #fff;
}
