.admin-page { padding: 24rpx; }
.notice { padding: 28rpx; margin-bottom: 24rpx; }
.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}
.notice-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.export-card { padding: 28rpx; margin-bottom: 20rpx; }
.export-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}
.export-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}
.export-btn {
  text-align: center;
  background: linear-gradient(135deg, #f06292, #ce93d8);
  color: #fff;
  border-radius: 16rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
}
