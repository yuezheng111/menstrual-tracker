.admin-page {
  padding: 24rpx;
}
.admin-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.admin-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.admin-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.logout-btn {
  background: rgba(255,255,255,0.35);
  border: 1px solid var(--glass-border);
  border-radius: 32rpx;
  padding: 10rpx 28rpx;
  font-size: 26rpx;
  color: var(--pink-500);
}
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.stat-card {
  width: calc(33.333% - 12rpx);
  padding: 24rpx 0;
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--pink-500);
}
.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}
.section-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}
.symptom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.symptom-name {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.symptom-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: rgba(255,255,255,0.3);
  border-radius: 12rpx;
  overflow: hidden;
}
.symptom-bar {
  height: 100%;
  background: linear-gradient(90deg, #f06292, #ce93d8);
  border-radius: 12rpx;
}
.symptom-count {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.empty-text {
  text-align: center;
  color: var(--text-muted);
  font-size: 26rpx;
  padding: 30rpx 0;
}
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.menu-item {
  width: calc(50% - 8rpx);
  padding: 32rpx 0;
  text-align: center;
  color: var(--text-primary);
  font-size: 28rpx;
}
.menu-emoji {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}
