.glass-card { background: rgba(255,255,255,0.15); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px); border: 1px solid rgba(255,255,255,0.30); border-radius: 24px; box-shadow: 0 4px 16px rgba(236,64,122,0.08); padding: 20px; transition: all 0.3s ease; } .glass-card:active { transform: scale(0.97); }
