.cute-btn { box-sizing: border-box; background: linear-gradient(135deg,#f06292,#ce93d8,#ec407a,#ba68c8,#f06292); background-size: 300% 300%; animation: flowGrad 4s ease infinite; color: white; border: none; border-radius: 24px; padding: 14px 32px; font-size: 16px; font-weight: 600; text-align: center; box-shadow: 0 4px 16px rgba(236,64,122,0.30); } .cute-btn:active { transform: scale(0.96); } .btn-sm { padding: 8px 20px; font-size: 14px; border-radius: 18px; }
